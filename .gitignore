__pycache__/
*.pyc
.env
.venv/
.dev.vars

# 資料與工作狀態：每日更新的工作集在 R2（state_sync.py），不入 git（data/ 約 7 GB，含影片研究）
data/
# logs/ 以 logs/* 排除（目錄層排除時 ! 例外無效）；大盤頁每日重建要的建置腳本必須入庫，Actions 才跑得起來。
logs/*
!logs/fetch_analysis_data.py
!logs/build_analysis_data.py
!logs/build_chips_data.py
!logs/build_stock_detail.py
!logs/check_*.py
!logs/verify_stock_history.py
reports/

# 暫存、驗證產物、會員研究截圖與錄製（.tmp/member-audit 含會員名稱，絕不入庫）
.tmp/
.wrangler/
.taste-skill/
*.partial
*.bak
*.bak-*
*-backup.*
*-backup-*
live_server-*-backup.py

# web/：資料檔與人寫文字由每日流程或 R2 工作集提供，只入程式
web/*-data.js
web/*-data-*.js
web/*-backup*
web/*-v[0-9]*.*
web/minimal-agent-backup.*
web/live*.js
web/index.html
web/visual-preview.html
web/market-data-local-*.js
web/kchart-*.js

# 設計預覽的截圖、大型產物與資料副本（預覽目錄內的 *-data.js 是行情資料複本，不入庫）
design-previews/**/*.png
design-previews/**/*.webm
design-previews/**/*.mp4
design-previews/**/*-data.js
design-previews/**/live.js
design-previews/**/market-data-local.js
design-previews/unslop-20261109/web/
design-previews/unslop-20261109/sweep/
design-previews/unslop-20261109/shots/

# 專案 2026-11-23 起公開（本人決定，為了 GitHub Actions 的執行時數）。以下只留本機、不入庫：
# 內部工作檔（規格、票、試跑紀錄、截圖；裡面有站主關注哪些股票）
.scratch/
# 主來源定案與接手狀態：含本人原話與 session UUID
/ANALYSIS_PLAN.md
/STATUS.md
# 設計樣品：只有工具程式（.py／.mjs）入庫，樣品頁、截圖與資料副本留本機
design-previews/**
!design-previews/**/
!design-previews/**/*.py
!design-previews/**/*.mjs

# 本機 Claude Code 權限設定（個人用，不入庫）
