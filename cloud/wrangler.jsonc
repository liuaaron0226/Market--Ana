// Pages 專案 market-ana（前端＋_middleware 閘門）。部署：node build.mjs && npx wrangler@4 pages deploy dist
{
  "name": "market-ana",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-07",
  "d1_databases": [
    { "binding": "DB", "database_name": "market-ana-accounts", "database_id": "391bc764-2dd8-47b3-b9f9-93b9521c59e7", "migrations_dir": "migrations" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://feb--2.cloudflareaccess.com",
    "MAIN_AUD": "432702e4180ff19534dfc612126e65d7bc3242197b79fe85abb007eb521b302b",
    "APPLY_AUD": "f8d3288f2326f9ad1c4cc8908d0a0b321b2f0ceb014273ce631513144a3ecacd",
    "OWNER_EMAIL": "owner@example.com",
    // 本人 2026-11-14：先打開「短中長期走勢」與「個股操作策略」。AI 解讀、現金水位仍由 MARKET_ANA_STRATEGIES_ENABLED 控制（未設＝關）。
    "MARKET_ANA_ENABLED_FEATURES": "strategy_v1,market_trend_v1"
  }
}
