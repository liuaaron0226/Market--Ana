// Pages 專案 market-ana（前端＋_middleware 閘門）。部署：node build.mjs && npx wrangler@4 pages deploy dist
{
  "name": "market-ana",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-07",
  "d1_databases": [
    { "binding": "DB", "database_name": "market-ana-accounts", "database_id": "391bc764-2dd8-47b3-b9f9-93b9521c59e7", "migrations_dir": "migrations" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://feb--2.cloudflareaccess.com",
    "MAIN_AUD": "432702e4180ff19534dfc612126e65d7bc3242197b79fe85abb007eb521b302b",
    "APPLY_AUD": "f8d3288f2326f9ad1c4cc8908d0a0b321b2f0ceb014273ce631513144a3ecacd",
    // OWNER_EMAIL（站主的信箱）不寫在這個檔：專案公開後任何人都看得到。改放 Pages 的機密設定
    // （wrangler pages secret put OWNER_EMAIL --project-name market-ana；正式與預覽各一份）。沒有它整站回 503。
    // 本人 2026-11-14：「短中長期走勢」保留顯示；「個股操作策略」同日回測後決定先關掉（扣成本後賠錢，見 ANALYSIS_PLAN 頂部）。
    // AI 解讀、現金水位仍由 MARKET_ANA_STRATEGIES_ENABLED 控制（未設＝關）。
    "MARKET_ANA_ENABLED_FEATURES": "market_trend_v1",
    // 本人 2026-11-15：預測帳本對站主打開（試跑；其他獲准使用者看不到）。關閉＝拿掉這一行再部署。
    // 本人 2026-11-24「全部功能都開放」→ 改 "all"（三種狀態：off／owner／all）：其他獲准使用者讀得到同一本帳，網站這邊只能讀。只開站主＝改回 "owner"。
    "MARKET_ANA_FORECAST_LEDGER": "all",
    // 本人 2026-11-17「全部照做」（session 49cca943 當面確認 7ac551af 轉來的「可以」）：個股頁事實區塊開給全部獲准使用者。只開站主＝改回 "owner"，關閉＝拿掉這一行再部署。
    "MARKET_ANA_STOCK_FACTS": "all",
    // 本人 2026-11-16「今天一起上線」：自選股關注開關只對站主打開（只認一字不差的 "owner"）。關閉＝拿掉這一行再部署。
    "MARKET_ANA_WATCHLIST_WATCH": "owner",
    // 本人 2026-11-17「全部照做」：五塊新功能開給全部獲准使用者（畫面已隨立體淺色看盤桌版上線）。只開站主＝改回 "owner"，關閉＝拿掉這一行再部署。
    "MARKET_ANA_STOCK_SIGNALS": "all",
    // 本人 2026-11-17「全部照做」：ETF 上站（12 票，股票型 ETF 搜尋得到、有個股頁、可加自選與對照）開給全部獲准使用者。
    // 只開站主＝改回 "owner"，關閉＝拿掉這一行再部署。
    "MARKET_ANA_STOCK_ETFS": "all",
    // 本人 2026-11-18「核准的人都看得到」：基金當成一般個股（貝萊德世界科技 A10：搜尋、個股頁、比較、自選、庫存）開給全部獲准使用者。
    // 需要正式資料庫已套 0025、0026。只開站主＝改回 "owner"，關閉＝拿掉這一行再部署。
    "MARKET_ANA_STOCK_FUNDS": "all",
    // 首頁「消息」與個股頁新聞標題（本人 2026-11-19）：原本先只開站主；本人 11-19 晚「我朋友看不到消息」→ 開給全部獲准使用者。
    // 朋友看得到總結與台、美、日韓中；「我的自選」各看各的。只開站主＝改回 "owner"。
    "MARKET_ANA_MARKET_NEWS": "all",
    // 盯項：首頁頁首「在盯 N 件」（本人 2026-11-20，.scratch/impact-watch 票 03）。先只開站主，本人看過再改 "all"
    // （朋友只看得到大盤的盯項）。需要正式資料庫已套 0034；關閉＝拿掉這一行再部署。
    // 本人 2026-11-24「把我所擁有的全部功能都開放給我本人以外都可以一起使用」→ 改 "all"：朋友只拿到對象是大盤的盯項，
    // 站主自選股與庫存的個股盯項照舊只回給站主；推播照舊只送站主自己的裝置。只開站主＝改回 "owner"。
    "MARKET_ANA_IMPACT_WATCH": "all",
    // 盤勢解讀改版（本人 2026-11-23，.scratch/market-brief 票 02）：類別鍵＋圖。關著時首頁照舊顯示原本的解讀。
    // 打開要先問本人、而且正式資料庫要先套 0035：先改 "owner"（只開站主），本人看過再改 "all"。
    // 本人 2026-11-24「全部功能都開放」→ 改 "all"：那一份只有大家共用的市場內容；追蹤事項（tracking）那一類照舊只回給站主。
    "MARKET_ANA_MARKET_BRIEF": "all",
    // 主力分點：個股頁「比較」右邊的「主力分點」副圖（本人 2026-11-24，.scratch/broker-branches 票 01）。只有 "off"／"owner"，沒有開給朋友的值。
    // 打開要先問本人、而且正式資料庫要先套 0036 並回補過至少一檔：改成 "owner"。
    // 本人 2026-11-24 晚「全部功能都開放」之後程式改成三種狀態（off／owner／all），但這裡先留 "owner"：
    // 分點只抓站主的自選股與庫存，開給全部的話「哪幾檔有分點」就等於讓別人看到站主的名單；要先決定抓取範圍再改 "all"。
    "MARKET_ANA_BROKER_BRANCHES": "owner",
    // 海外大盤的分時：大盤頁切到國外指數後可以選「分時」，切換清單多一項那斯達克期貨（本人 2026-11-24，.scratch/index-intraday 票 01）。
    // 資料是使用者打開時向 Yahoo Finance 公開入口要的 5 分鐘線，不用套資料表。打開要先問本人：先改 "owner"（只開站主），本人看過再改 "all"。
    // 本人 2026-11-24「全部功能都開放」→ 改 "all"：回的只有公開指數與匯率的 5 分鐘線，沒有個人資料；同一個指數 60 秒內只問來源一次、每人另有限流。
    "MARKET_ANA_INDEX_INTRADAY": "all",
    // AI 產業鏈資金版圖：獨立一頁 /chain-map（本人 2026-11-24，.scratch/ai-chain-map 票 01）。"off"／"owner"（只開站主）／"all"（全部獲准使用者）。
    // 關著時那一頁與 /api/chain-map 和不存在一樣。資料表還沒有資料時（0039 未套、每日建置還沒寫第一列），那一頁顯示「尚未就緒」。
    // 美股數字來自 Massive（與起始資料的 Yahoo），兩家條款都限本人私用；本人 2026-11-24 晚聽過風險後決定「全部都開」並看過清單 → "all"。
    // 行情商來函或金鑰被停時：改成 "owner"（只剩站主看得到）再重新部署。
    "MARKET_ANA_CHAIN_MAP": "all",
    // 資料更新狀態：設定頁「資料更新」那一籤（2026-11-24，cloud/lib/data-health.js）。只給站主；"owner" 或 "all" 都只開站主。
    // 推播提醒在 cron-trigger，有自己的同名開關（cron-trigger/wrangler.toml），要等正式資料庫套了 0040 才會送。
    // 本人 2026-11-24 晚授權上線：設定頁那一籤不需要 0040（每次打開即時判斷）。
    "MARKET_ANA_DATA_HEALTH": "owner",
    // 富果（Fugle）即時行情：個股頁的即時報價與盤中投影、當天逐筆（秒 K）、首頁大盤的即時、庫存收盤後用今天的收盤。
    // 原本「行情商條款不得轉給第三方」只給站主；本人 2026-11-24 晚聽過條款限本人私用、金鑰可能被停之後決定「全部都開」→ "all"。
    // 行情商來函或金鑰被停時：改成 "owner" ＝ 所有富果資料（連 11-18 開放的分時、五檔、60 分K）都只給站主；
    // 拿掉這一行＝回到 11-24 以前（分時、五檔、60 分K 大家看得到，即時報價與逐筆只給站主）。改完要重新部署才生效。
    "MARKET_ANA_LIVE_QUOTES": "all",
    // 本人 2026-11-16 20:2x「現在打開」：朋友 AI（已核准的朋友自己設定 Gemini 金鑰、每天用自己的金鑰產生大盤與籌碼解讀）。
    // 只認 "on"；主金鑰放在 Pages 與 GitHub 的機密設定，不寫在這裡。關閉＝拿掉這一行再部署（GitHub variable 也一起關）。
    "MARKET_ANA_FRIEND_AI": "on"
  }
}
